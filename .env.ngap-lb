# NGAP Load Balancing Environment Configuration
# Custom .env for loxilb + multi-AMF deployment

# Timezone
#TZ=Europe/Berlin

# PLMN Configuration
MCC=001
MNC=01
TAC=1

# Docker Network
TEST_NETWORK=172.22.0.0/24
DOCKER_HOST_IP=192.168.1.223

# ============================================
# loxilb Load Balancer
# ============================================
LOXILB_IP=172.22.0.100
# Virtual IP for NGAP load balancing (gNB connects to this)
LOXILB_VIP=20.20.20.1

# ============================================
# Core Infrastructure
# ============================================
MONGO_IP=172.22.0.2
WEBUI_IP=172.22.0.26
NRF_IP=172.22.0.12
SCP_IP=172.22.0.35

# ============================================
# AMF Instances (Load Balanced)
# ============================================
# AMF 1 - Primary
AMF1_IP=172.22.0.10
# AMF 2 - Secondary
AMF2_IP=172.22.0.50
# Legacy AMF_IP variable (for compatibility)
AMF_IP=172.22.0.10

# ============================================
# Other 5G Core NFs
# ============================================
AUSF_IP=172.22.0.11
UDM_IP=172.22.0.13
UDR_IP=172.22.0.14
PCF_IP=172.22.0.27
BSF_IP=172.22.0.29
NSSF_IP=172.22.0.28
SMF_IP=172.22.0.7
UPF_IP=172.22.0.8
UPF_ADVERTISE_IP=172.22.0.8

# UPF Interface Configuration
UPF_TUNTAP_MODE=tun
UPF_INTERNET_APN_IF_NAME=ogstun
UPF_IMS_APN_IF_NAME=ogstun2

# SMF DNS
SMF_DNS1=8.8.8.8
SMF_DNS2=8.8.4.4

# ============================================
# IMS/Diameter (for SMF compatibility)
# ============================================
PCSCF_IP=172.22.0.21
PCRF_IP=172.22.0.4
PCRF_BIND_PORT=3873
OCS_IP=172.22.0.40
OCS_BIND_PORT=3872
OSMOEPDG_IP=172.22.0.41

# ============================================
# UERANSIM Configuration
# ============================================
NR_GNB_IP=172.22.0.23
NR_UE_IP=172.22.0.24

# Test UE Credentials
UE1_IMEI=356938035643803
UE1_IMEISV=4370816125816151
UE1_IMSI=001011234567895
UE1_KI=8baf473f2f8fd09487cccbd7097c6862
UE1_OP=11111111111111111111111111111111
UE1_AMF=8000

# ============================================
# UE IP Pool
# ============================================
UE_IPV4_INTERNET=192.168.100.0/24
UE_IPV4_IMS=192.168.101.0/24

# Maximum UEs
MAX_NUM_UE=1024
